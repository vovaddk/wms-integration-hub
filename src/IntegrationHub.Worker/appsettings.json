{
  "ConnectionStrings": {
    "WmsIntegrationHub": "Server=localhost\\SQLEXPRESS;Database=WmsIntegrationHub;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Polly": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ",
        "UseUtcTimestamp": true
      }
    }
  },
  "Worker": {
    "BatchSize": 20,
    "Lease": "00:05:00",
    "IdleDelay": "00:00:02"
  },
  "Retry": {
    "MaxAttempts": 5,
    "BaseDelay": "00:00:05",
    "MaxDelay": "00:10:00"
  },
  "FileDrop": {
    "Path": "../../filedrop",
    "PollInterval": "00:00:05"
  },
  "Outbox": {
    "Subscribers": [
      {
        "Name": "wms-ui",
        "Url": "http://localhost:5080/fake-subscriber/wms-ui",
        "Events": [ "OrderAccepted", "StockLevelChanged" ]
      },
      {
        "Name": "erp",
        "Url": "http://localhost:5080/fake-subscriber/erp",
        "Events": [ "OrderAccepted" ]
      }
    ]
  }
}
